{
  "manifest_version": 3,
  "name": "HikTab - Modo IE para câmeras",
  "short_name": "HikTab",
  "version": "1.2.0",
  "description": "Abre páginas (como DVRs/NVRs Hikvision) com o motor do Internet Explorer dentro de uma aba do Chrome, com suporte a ActiveX.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir esta página no modo IE (ou voltar ao Chrome)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "storage",
    "contextMenus",
    "webNavigation"
  ],
  "host_permissions": [
    "http://10.0.45.117/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://10.0.45.117/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["video.html"],
      "matches": ["http://10.0.45.117/*"]
    }
  ]
}
